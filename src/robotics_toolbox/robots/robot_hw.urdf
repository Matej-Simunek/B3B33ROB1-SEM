<?xml version="1.0"?>
<robot name="spatial_4dof_robot">

  <!-- Definice barev -->
  <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>
  <material name="green"><color rgba="0.2 0.8 0.2 1.0"/></material>

  <!-- ================= BASE LINK ================= -->
  <!-- Střed je v 0,0,0. Velikost 0.3 m znamená, že Z zasahuje od -0.15 do 0.15 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.3"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- ================= JOINT 1 (Revolute Z) ================= -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1_cylinder"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/> <!-- Umístěno na vršek základny -->
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796" upper="1.570796" effort="100" velocity="2.0"/>
  </joint>

  <!-- ================= LINK 1 (Cylinder) ================= -->
  <link name="link_1_cylinder">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/> <!-- Střed 0.5m dlouhého válce -->
      <geometry>
        <cylinder radius="0.1" length="0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- ================= FIXED JOINT (Cyl 1 -> Sph 1) ================= -->
  <joint name="joint_sph_1" type="fixed">
    <parent link="link_1_cylinder"/>
    <child link="link_1_sphere"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/> <!-- Umístěno na vršek prvního válce -->
  </joint>

  <!-- ================= LINK 1 (Sphere) ================= -->
  <link name="link_1_sphere">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <!-- ================= JOINT 2 (Revolute X) ================= -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1_sphere"/>
    <child link="link_2_cylinder"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> <!-- Osa otáčení je přímo ve středu první koule -->
    <axis xyz="1 0 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="100" velocity="2.0"/>
  </joint>

  <!-- ================= LINK 2 (Cylinder) ================= -->
  <link name="link_2_cylinder">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/> <!-- Střed 0.25m dlouhého válce -->
      <geometry>
        <cylinder radius="0.05" length="0.25"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- ================= JOINT 3 (Revolute Z) ================= -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2_cylinder"/>
    <child link="link_3_cylinder"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/> <!-- Umístěno na vršek druhého válce -->
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796" upper="1.570796" effort="100" velocity="2.0"/>
  </joint>

  <!-- ================= LINK 3 (Cylinder) ================= -->
  <link name="link_3_cylinder">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.25"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- ================= FIXED JOINT (Cyl 3 -> Sph 2) ================= -->
  <joint name="joint_sph_2" type="fixed">
    <parent link="link_3_cylinder"/>
    <child link="link_2_sphere"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/> <!-- Umístěno na vršek třetího válce -->
  </joint>

  <!-- ================= LINK 2 (Sphere) ================= -->
  <link name="link_2_sphere">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <!-- ================= JOINT 4 (Revolute X) ================= -->
  <joint name="joint_4" type="revolute">
    <parent link="link_2_sphere"/>
    <child link="link_4_cylinder"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> <!-- Osa otáčení je přímo ve středu druhé koule -->
    <axis xyz="1 0 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="100" velocity="2.0"/>
  </joint>

  <!-- ================= LINK 4 (Cylinder) ================= -->
  <link name="link_4_cylinder">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.25"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- ================= EE JOINT (Fixed) ================= -->
  <joint name="joint_ee" type="fixed">
    <parent link="link_4_cylinder"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/> <!-- Koncový bod na vrcholu čtvrtého válce -->
  </joint>

  <!-- ================= EE LINK ================= -->
  <link name="ee_link">
    <!-- Fiktivní end effector bez geometrie -->
  </link>

</robot>